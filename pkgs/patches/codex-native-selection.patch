+use super::HerdrSessionReporter;
+use codex_protocol::ThreadId;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::net::UnixListener;
+
+async fn receive_selection(
+    reporter: &mut HerdrSessionReporter,
+    listener: &UnixListener,
+    thread_id: Option<ThreadId>,
+) -> Value {
+    let (_, request) = tokio::join!(reporter.report(thread_id), async {
+        let (mut stream, _) = listener.accept().await.unwrap();
+        let mut line = String::new();
+        BufReader::new(&mut stream)
+            .read_line(&mut line)
+            .await
+            .unwrap();
+        let request: Value = serde_json::from_str(&line).unwrap();
+        let response = json!({"id":request["id"],"result":{}});
+        stream
+            .write_all(format!("{response}\n").as_bytes())
+            .await
+            .unwrap();
+        request
+    });
+    request
+}
+
+#[tokio::test]
+async fn native_selection_reports_cached_switches_and_clears_old_binding() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("runtime.sock");
+    let listener = UnixListener::bind(&path).unwrap();
+    let mut reporter = HerdrSessionReporter {
+        socket_path: path,
+        pane_id: "w1:p1".into(),
+        last_selection: None,
+        last_attempt: None,
+    };
+    let first = ThreadId::from_u128(1);
+    let second = ThreadId::from_u128(2);
+    for selected in [Some(first), Some(second), None, Some(first)] {
+        let request = receive_selection(&mut reporter, &listener, selected).await;
+        assert_eq!(
+            request,
+            json!({
+                "id":"codex:frontend:selection", "method":"pane.report_agent_session",
+                "params":{"pane_id":"w1:p1","source":"herdr:codex","agent":"codex",
+                "agent_session_id":selected.map(|id| id.to_string()),"session_start_source":"select"}
+            })
+        );
+    }
+    reporter.report(Some(first)).await;
+    assert!(
+        tokio::time::timeout(Duration::from_millis(10), listener.accept())
+            .await
+            .is_err()
+    );
+}
+
+#[tokio::test]
+async fn native_selection_retries_after_runtime_restart_without_another_switch() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("runtime.sock");
+    let mut reporter = HerdrSessionReporter {
+        socket_path: path.clone(),
+        pane_id: "w1:p1".into(),
+        last_selection: None,
+        last_attempt: None,
+    };
+    let first = ThreadId::from_u128(1);
+    reporter.report(Some(first)).await;
+    let listener = UnixListener::bind(&path).unwrap();
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    let request = receive_selection(&mut reporter, &listener, Some(first)).await;
+    assert_eq!(request["params"]["agent_session_id"], first.to_string());
+    drop(listener);
+    std::fs::remove_file(&path).unwrap();
+    let listener = UnixListener::bind(&path).unwrap();
+    tokio::time::sleep(Duration::from_secs(1)).await;
+    let request = receive_selection(&mut reporter, &listener, Some(first)).await;
+    assert_eq!(request["params"]["agent_session_id"], first.to_string());
+}
