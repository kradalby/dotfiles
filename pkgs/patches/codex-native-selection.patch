diff --git a/codex-rs/tui/src/app/herdr_selection.rs b/codex-rs/tui/src/app/herdr_selection.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app/herdr_selection.rs
@@ -0,0 +1,106 @@
+//! Report the frontend's selected thread independently of the shared app-server.
+
+#[cfg(unix)]
+mod unix {
+    use codex_protocol::ThreadId;
+    use serde_json::json;
+    use std::io;
+    use std::path::PathBuf;
+    use std::time::Duration;
+    use tokio::io::AsyncBufReadExt;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::io::BufReader;
+    use tokio::net::UnixStream;
+    use tokio::time::Instant;
+
+    pub(in crate::app) struct HerdrSessionReporter {
+        pub(super) socket_path: PathBuf,
+        pub(super) pane_id: String,
+        pub(super) last_selection: Option<Option<ThreadId>>,
+        pub(super) last_attempt: Option<Instant>,
+    }
+
+    impl HerdrSessionReporter {
+        pub(in crate::app) fn from_env() -> Option<Self> {
+            if std::env::var("HERDR_ENV").ok().as_deref() != Some("1") {
+                return None;
+            }
+            let socket_path = std::env::var_os("HERDR_SOCKET_PATH").filter(|p| !p.is_empty())?;
+            let pane_id = std::env::var("HERDR_PANE_ID")
+                .ok()
+                .filter(|p| !p.is_empty())?;
+            Some(Self {
+                socket_path: socket_path.into(),
+                pane_id,
+                last_selection: None,
+                last_attempt: None,
+            })
+        }
+
+        pub(in crate::app) async fn report(&mut self, thread_id: Option<ThreadId>) {
+            if self.last_selection == Some(thread_id)
+                && self
+                    .last_attempt
+                    .is_some_and(|at| at.elapsed() < Duration::from_secs(1))
+            {
+                return;
+            }
+            self.last_selection = Some(thread_id);
+            self.last_attempt = Some(Instant::now());
+            // A missing or stalled local runtime must not stop the frontend.
+            let _ = tokio::time::timeout(Duration::from_millis(100), self.send(thread_id)).await;
+        }
+
+        async fn send(&self, thread_id: Option<ThreadId>) -> io::Result<()> {
+            let request = json!({
+                "id": "codex:frontend:selection",
+                "method": "pane.report_agent_session",
+                "params": {
+                    "pane_id": self.pane_id,
+                    "source": "herdr:codex",
+                    "agent": "codex",
+                    "agent_session_id": thread_id.map(|id| id.to_string()),
+                    "session_start_source": "select"
+                }
+            });
+            let mut stream = UnixStream::connect(&self.socket_path).await?;
+            stream.write_all(format!("{request}\n").as_bytes()).await?;
+            let mut response = String::new();
+            BufReader::new(stream)
+                .take(16_384)
+                .read_line(&mut response)
+                .await?;
+            let response: serde_json::Value =
+                serde_json::from_str(&response).map_err(io::Error::other)?;
+            if response["id"] != request["id"]
+                || response.get("result").is_none()
+                || response.get("error").is_some()
+            {
+                return Err(io::Error::other(
+                    "herdr did not acknowledge frontend selection",
+                ));
+            }
+            Ok(())
+        }
+    }
+}
+
+#[cfg(unix)]
+pub(super) use unix::HerdrSessionReporter;
+
+#[cfg(not(unix))]
+pub(super) struct HerdrSessionReporter;
+
+#[cfg(not(unix))]
+impl HerdrSessionReporter {
+    pub(super) fn from_env() -> Option<Self> {
+        None
+    }
+
+    pub(super) async fn report(&mut self, _thread_id: Option<codex_protocol::ThreadId>) {}
+}
