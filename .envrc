use flake

# Reuses the infra (terraform) tailscale OAuth client; replace with a
# rotate-scoped client at infra/tailscale/kradalby/rotate-oauth/* if needed.
secret_env -v <<'SECRETS'
  TS_ROTATE_CLIENT_ID      infra/tailscale/kradalby/oauth/client-id
  TS_ROTATE_CLIENT_SECRET  infra/tailscale/kradalby/oauth/client-secret
SECRETS
export TS_ROTATE_DOMAIN=kradalby.no

# Self-hosted garnix CI: API token + server URL, for the garnix API/CLI.
# GARNIX_TOKEN is an access token, not a JWT — it is the *password* half of
# Basic auth against POST /api/auth/jwt, which mints the 1h Bearer JWT the
# rest of the API wants. Sent as a Bearer token it silently reads as
# anonymous: fine on public repos, a misleading 404 on private ones.
secret_env -v <<'SECRETS'
  GARNIX_TOKEN   garnix/api/token
  GARNIX_SERVER  garnix/api/server
SECRETS

source_env_if_exists .envrc.local
